# Build stage
FROM golang:1.27-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Build server statically
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/quicktable ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/qt ./cmd/client

# Runtime stage
FROM alpine:3

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 10001 -S quicktable && \
    adduser -u 10001 -S -G quicktable -h /data -s /sbin/nologin quicktable && \
    mkdir -p /data && chown -R quicktable:quicktable /data

COPY --from=builder /bin/quicktable /usr/local/bin/quicktable
COPY --from=builder /bin/qt /usr/local/bin/qt

USER quicktable:quicktable
WORKDIR /data

EXPOSE 16000

ENTRYPOINT ["quicktable"]
CMD ["-addr", ":16000", "-dir", "/data"]

LABEL org.opencontainers.image.source=https://github.com/TheDevtop/quicktable
LABEL org.opencontainers.image.licenses=MIT
